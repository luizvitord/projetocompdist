              <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
              <stringProp name="TestPlan.comments">Gera um grade.posted e, no notificacao-service, notificacoes para ALUNO e RESPONSAVEL</stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Monta as notas das matriculas">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters" />
                <stringProp name="filename" />
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">// Uma nota de 0 a 10 para cada matricula da massa
def r = java.util.concurrent.ThreadLocalRandom.current()
def notas = props.get('matriculas').split(',').collect { m -&gt;
    String.format(Locale.ROOT, '{"matriculaAluno": "%s", "valor": %.1f}', m, r.nextInt(0, 101) / 10.0)
}
vars.put('notasBody', '[' + notas.join(', ') + ']')</stringProp>
              </JSR223PreProcessor>
              <hashTree />
            </hashTree>
          </hashTree>
